<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.iesalandalus.programacion.tallermecanico.vista.grafica.controladores.VentanaPrincipal">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Fichero">
            <items>
              <MenuItem fx:id="btCerrar" mnemonicParsing="false" onAction="#salir" text="Cerrar" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#acercaDe" text="Acerca de..." />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" spacing="20.0">
         <children>
            <VBox alignment="CENTER" prefHeight="400.0" prefWidth="150.0" spacing="40.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="CLIENTES" />
                  <Button mnemonicParsing="false" onAction="#insertarCliente" text="Insertar" />
                  <Button mnemonicParsing="false" onAction="#buscarCliente" text="Buscar" />
                  <Button mnemonicParsing="false" onAction="#borrarCliente" text="Borrar" />
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="339.0" prefWidth="150.0" spacing="40.0">
               <children>
                  <Label text="VEHICULOS" />
                  <Button fx:id="btInsertarVehiculo" mnemonicParsing="false" onAction="#insertarVehiculo" text="Insertar" />
                  <Button fx:id="btBuscarVehiculo" mnemonicParsing="false" onAction="#buscarVehiculo" text="Buscar" />
                  <Button fx:id="btBorrarVehiculo" mnemonicParsing="false" onAction="#borrarVehiculo" text="Borrar" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
            <VBox alignment="CENTER" prefHeight="324.0" prefWidth="150.0" spacing="40.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label text="TRABAJOS" />
                  <Button mnemonicParsing="false" onAction="#insertarTrabajo" text="Insertar" />
                  <Button mnemonicParsing="false" onAction="#buscarTrabajo" text="Buscar" />
                  <Button mnemonicParsing="false" onAction="#borrarTrabajo" text="Borrar" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
